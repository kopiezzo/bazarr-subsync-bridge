# Image tag from ghcr.io/kopiezzo/bazarr-subsync-bridge, for example 2 or 2.0.0
BRIDGE_VERSION=latest

# Host path where your media lives, and the same path inside the container.
# The container path must match the paths Bazarr writes into jobs (and the paths Plex sees, for Plex refresh).
MEDIA_HOST_PATH=/path/to/media
MEDIA_CONTAINER_PATH=/media

# Queue shared with Bazarr and the log directory on the host (relative paths are allowed)
QUEUE_HOST_PATH=./queue
LOGS_HOST_PATH=./logs

# User and group the container runs as; match the owner of the queue, log, and subtitle directories
PUID=1000
PGID=1000

# SubSync tuning
SUBSYNC_EFFORT=0.5
SUBSYNC_MAX_WINDOW=600
SUBSYNC_MIN_CORRELATION=0.5
SUBSYNC_LOG_LEVEL=1
SUBSYNC_TIMEOUT=3600
SUBSYNC_KEEP_BACKUP=0

# Plex refresh (optional; leave empty to disable)
PLEX_URL=
PLEX_TOKEN=
