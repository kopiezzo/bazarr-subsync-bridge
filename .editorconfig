# Shared repository standard
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{py,java,kt,ps1}]
indent_size = 4

[*.{yml,yaml,json,js,mjs,ts,astro,css,html,sh}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
